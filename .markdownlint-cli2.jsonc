{
  // markdownlint owns the *structure* of the Markdown (headings, lists, tables, fences);
  // textlint owns the prose and cspell the spelling, so the three never overlap.
  //
  // Every default rule is on. A rule that does not fit this repository is turned off here
  // with the reason next to it, never left silently unset.
  "config": {
    "default": true,

    // MD013 (line-length) is off: the API table in packages/effect-to-openapi/README.md is
    // one row per export and a table row cannot wrap. Prose width is oxfmt's job (`vp fmt`),
    // not a linter's.
    "MD013": false,

    // The same heading may repeat under different parents ("Install" in the root README and in
    // the package README). Only siblings are a real duplicate.
    "MD024": { "siblings_only": true },

    // Ordered lists count 1. 2. 3. — the shape oxfmt writes — rather than all-ones.
    "MD029": { "style": "ordered" },

    // Every fenced block declares a language so GitHub highlights it and a reader can tell
    // `ts` from `bash` at a glance. The list is closed on purpose: a typo like `typescript`
    // vs `ts` would otherwise split the highlighting between two spellings.
    "MD040": {
      "allowed_languages": [
        "ts",
        "tsx",
        "js",
        "json",
        "jsonc",
        "yaml",
        "yml",
        "bash",
        "sh",
        "text",
        "diff",
        "md",
      ],
    },
  },

  // `gitignore: true` drops node_modules, dist, coverage and test/out automatically, so this
  // never drifts from .gitignore.
  "globs": ["**/*.md"],
  "gitignore": true,
}
