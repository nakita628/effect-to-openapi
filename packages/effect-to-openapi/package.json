{
  "name": "effect-to-openapi",
  "version": "0.0.2",
  "description": "Builds OpenAPI 3.0 / 3.1 / 3.2 documents from Effect Schema (v4) — zero runtime and type dependencies besides effect",
  "keywords": [
    "effect",
    "effect-schema",
    "openapi"
  ],
  "homepage": "https://github.com/nakita628/effect-to-openapi",
  "bugs": {
    "url": "https://github.com/nakita628/effect-to-openapi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakita628/effect-to-openapi.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "effect": "4.0.0-rc.112",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112"
  }
}
